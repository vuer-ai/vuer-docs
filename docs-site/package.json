{
  "name": "vuer-docs",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/prepare.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare.mjs && vite build && vike prerender && pagefind --site dist/client",
    "preview": "vite preview --host 127.0.0.1",
    "postinstall": "node scripts/patch-dockit.mjs",
    "prebuild": "node scripts/patch-dockit.mjs",
    "import:legacy": "node scripts/import-legacy.mjs",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@dreamlake/dockit": "0.2.14",
    "@mdx-js/react": "^3.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vike": "^0.4.260",
    "vike-react": "^0.5.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "github-slugger": "2.0.0",
    "hast-util-to-mdast": "10.1.2",
    "markdown-it": "^14.1.0",
    "pagefind": "^1.5.2",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-stringify": "11.0.0",
    "style-to-js": "2.0.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.0",
    "unified": "11.0.5",
    "vite": "^7.0.0"
  }
}
